# ---- Supabase ----
# Public URL and anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER-SIDE ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Maps (Google Maps JS API) ----
# Client-side key from Google Cloud Console. Restrict it by HTTP referrer in GCP.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Email notifications (optional) ----
# When unset, email notifications degrade to server logs and the app keeps
# working. Supported provider: resend.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Shifa <no-reply@shifa.example>

# ---- Application ----
APP_BASE_URL=http://localhost:3000

# ---- Demo data ----
# Set to "false" in production to exclude demo products/pharmacies from reads.
INCLUDE_DEMO_DATA=true

# ---- Stock freshness thresholds (hours) ----
STOCK_RECENT_HOURS=2
STOCK_STALE_HOURS=24

# ---- Reservation expiry (hours) ----
RESERVATION_EXPIRY_HOURS=24

# ---- First-admin bootstrap (used by `npm run create-admin`) ----
# One-time token that must match to create the initial admin account.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
